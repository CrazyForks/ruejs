{
  "name": "rue-site",
  "version": "0.8.1",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "directories": {
    "example": "examples"
  },
  "type": "module",
  "scripts": {
    "preapp-dev": "node scripts/pre-app-dev.js",
    "docs-search-index": "node scripts/generate-doc-search-index.js",
    "runtime-vapor-addr2line": "node scripts/runtime-vapor-addr2line.js",
    "preapp-build": "node scripts/pre-app-dev.js",
    "preapp-static-build": "node scripts/pre-app-dev.js",
    "app-dev": "vite",
    "app-build": "vite build",
    "app-static-build": "node scripts/app-static-build.mjs",
    "app-static-preview": "node scripts/app-static-preview.mjs",
    "app-preview": "vite preview",
    "example:static-render:build": "node examples/static-render/build.mjs",
    "example:static-render:preview": "node examples/static-render/preview.mjs",
    "example:text-blog-ssr:dev": "pnpm --dir examples/text-blog-ssr dev",
    "example:text-blog-ssr:build": "pnpm --dir examples/text-blog-ssr build",
    "example:text-blog-ssr:start": "pnpm --dir examples/text-blog-ssr start",
    "example:text-static-export:dev": "pnpm --dir examples/text-static-export dev",
    "example:text-static-export:build": "pnpm --dir examples/text-static-export build",
    "example:text-static-export:start": "pnpm --dir examples/text-static-export start",
    "example:vite-express-ssr": "node examples/vite-express-ssr/server.mjs",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "build-dts": "tsgo -p tsconfig.build.json --noCheck && node scripts/build-dts.js",
    "test-dts": "pnpm run build-dts",
    "ensure-runtime-vapor-build": "node scripts/ensure-runtime-vapor-build.js",
    "clean": "rimraf --glob packages/*/dist temp",
    "size": "run-s \"size-*\" && node scripts/usage-size.js",
    "size-global": "node scripts/build.js rue runtime -f global -p --size",
    "size-esm-runtime": "node scripts/build.js rue -f esm-bundler-runtime",
    "size-esm": "node scripts/build.js runtime shared -f esm-bundler",
    "check": "tsgo --incremental --noEmit",
    "check:text": "pnpm --dir packages/text check",
    "check:compat-cleanup": "node scripts/check-compat-cleanup.js",
    "oxlint": "oxlint -c ./.oxlintrc.json . packages/text",
    "oxlint-fix": "oxlint -c ./.oxlintrc.json . packages/text --fix",
    "format": "oxfmt . packages/text",
    "format-check": "oxfmt --check . packages/text",
    "test": "pnpm run ensure-runtime-vapor-build && pnpm check:compat-cleanup && vitest run",
    "test:text": "pnpm --dir packages/text test",
    "test:text-unit": "pnpm --dir packages/text test-unit",
    "test:all": "pnpm run test && pnpm run test:text",
    "test-watch": "pnpm run ensure-runtime-vapor-build && vitest",
    "test-unit": "pnpm run ensure-runtime-vapor-build && vitest run --project unit*",
    "test-unit-watch": "pnpm run ensure-runtime-vapor-build && vitest --project unit*",
    "test-coverage": "pnpm run ensure-runtime-vapor-build && vitest run --coverage",
    "pretest-e2e": "node scripts/ensure-runtime-vapor-build.js",
    "test-e2e": "node scripts/build.js rue -f global -d && vitest run --project e2e --passWithNoTests",
    "test-coverage-unit": "pnpm run ensure-runtime-vapor-build && vitest run --project unit* --coverage",
    "prebench": "node scripts/build.js -pf esm-browser",
    "prebench-compare": "node scripts/build.js -pf esm-browser",
    "bench": "vitest bench --project=unit --outputJson=temp/bench.json",
    "bench-compare": "vitest bench --project=unit --compare=temp/bench.json",
    "release": "node scripts/release.js",
    "release-check": "npm run oxlint-fix && npm run format && node scripts/release.js --check --skipPrompts",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "dev-esm": "node scripts/dev.js -if esm-bundler-runtime",
    "dev-sfc": "run-s dev-sfc-prepare",
    "dev-sfc-prepare": "node scripts/pre-dev-sfc.js || npm run build-all-cjs",
    "serve": "serve",
    "build-sfc-playground": "run-s build-all-cjs build-runtime-esm build-browser-esm build-sfc-playground-self",
    "build-all-cjs": "node scripts/build.js rue runtime shared -af cjs",
    "build-runtime-esm": "node scripts/build.js runtime shared -af esm-bundler && node scripts/build.js rue -f esm-bundler-runtime && node scripts/build.js rue -f esm-browser-runtime",
    "build-browser-esm": "node scripts/build.js runtime shared -af esm-bundler && node scripts/build.js rue -f esm-bundler && node scripts/build.js rue -f esm-browser",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@rue-js/design": "workspace:*",
    "@rue-js/i18n": "workspace:*",
    "@rue-js/jsx-runtime": "workspace:*",
    "@rue-js/router": "workspace:*",
    "@rue-js/rsc": "workspace:*",
    "@rue-js/rue": "workspace:*",
    "@rue-js/runtime": "workspace:*",
    "@rue-js/runtime-vapor": "workspace:*",
    "@rue-js/server-renderer": "workspace:*",
    "@rue-js/shared": "workspace:*",
    "@rue-js/store": "workspace:*",
    "@rue-js/vite-plugin-rue": "workspace:*",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "cally": "^0.9.2",
    "pikaday": "^1.8.2",
    "satteri": "^0.9.4",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@babel/types": "catalog:",
    "@cloudflare/vite-plugin": "^1.39.0",
    "@opentelemetry/api": "^1.9.1",
    "@rue-js/jsx-dev-runtime": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.1",
    "@types/animejs": "^3.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "beta",
    "@vitejs/devtools": "^0.3.1",
    "@vitest/coverage-v8": "4.1.5",
    "better-sqlite3": "^12.10.0",
    "c8": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-angular": "^8.3.1",
    "daisyui": "^5.5.19",
    "dts-bundle-generator": "^9.5.1",
    "enquirer": "^2.4.1",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.2",
    "magic-string": "catalog:",
    "msw": "^2.14.6",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "picocolors": "^1.1.1",
    "rimraf": "^6.1.3",
    "semver": "^7.7.4",
    "serve": "^14.2.6",
    "serve-handler": "^6.1.7",
    "simple-git-hooks": "^2.13.1",
    "swc-plugin-jsx-css-modules": "^0.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "validator": "^13.15.35",
    "vite": "catalog:",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "4.1.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm check",
    "commit-msg": "node scripts/verify-commit.js"
  },
  "lint-staged": {
    "*.{js,json}": [
      "oxfmt ."
    ],
    "*.ts?(x)": [
      "oxlint . --fix",
      "oxfmt ."
    ]
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17"
    },
    "patchedDependencies": {
      "@bruits/satteri-wasm32-wasi@0.9.4": "patches/@bruits__satteri-wasm32-wasi@0.9.4.patch"
    }
  }
}
