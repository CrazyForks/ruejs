{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@rue-js",
    "types": ["vitest/globals"],
    "declaration": true,
    "outDir": "./dist",
    "paths": {
      "@shikijs/langs/*": ["./app/types/shikijs-lang.d.ts"],
      "@shikijs/themes/*": ["./app/types/shikijs-theme.d.ts"],
      "@rue-js/rue": ["./packages/rue/src"],
      "@rue-js/rue/*": ["./packages/rue/src/*"],
      "@rue-js/router": ["./packages/router/src"],
      "@rue-js/store": ["./packages/store/src"],
      "@rue-js/i18n": ["./packages/i18n/src"],
      "@rue-js/jsx-runtime": ["./packages/jsx-runtime/src"],
      "@rue-js/jsx-dev-runtime": ["./packages/jsx-dev-runtime/src"],
      "@rue-js/runtime": ["./packages/runtime/src"],
      "@rue-js/runtime/*": ["./packages/runtime/src/*"],
      "@rue-js/server-renderer": ["./packages/server-renderer/src"],
      "@rue-js/vite-plugin-rue": ["./packages/vite-plugin-rue/index.mjs"],
      "@rue-js/shared": ["./packages/shared/src"],
      "@rue-js/design": ["./packages/rue-design/src"],
      "@rue-js/runtime-vapor": ["./packages/runtime-vapor/src/index.ts"],
      "@rue-js/runtime-vapor/protocol": ["./packages/runtime-vapor/src/protocol.ts"],
      "@rue-js/runtime-vapor/reactive": ["./packages/runtime-vapor/src/reactive.ts"],
      "@rue-js/runtime-vapor/vapor": ["./packages/runtime-vapor/src/vapor.ts"]
    },
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "app/app.tsx",
    "app/**/*",
    "tailwind.config.ts",
    "packages/global.d.ts",
    "packages/runtime-vapor/src/global.d.ts",
    "packages/rue/env.d.ts",
    "packages/*/src",
    "packages/*/__tests__",
    "packages/rue/jsx-runtime",
    "packages/rue/jsx.d.ts",
    "scripts/*"
  ],
  "exclude": ["node_modules", "dist", "packages/text", "packages/rue-rsc"]
}
