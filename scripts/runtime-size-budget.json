      "forbidWasm": true,
      "forbidSSRRenderer": true
    },
    "compiled-list": {
      "measurement": "absolute",
      "max": { "gzip": 3650 },
      "requireReactiveKernel": true,
      "requireCompiledRuntime": true,
      "forbidWasm": true,
      "forbidSSRRenderer": true
    },
    "compiled-builtins": {
      "measurement": "absolute",
      "max": { "gzip": 29600 },
      "requireCompiledRuntime": true,
      "forbidWasm": true,
      "forbidSSRRenderer": true
    },
    "hydrate": {
      "measurement": "absolute",
      "max": { "gzip": 50000 },
