{
  "name": "@rue-js/runtime-vapor",
  "version": "0.8.20",
  "description": "Rue JavaScript runtime backed by a strict TypeScript reactive graph kernel",
  "keywords": [
    "reactivity",
    "rue",
    "runtime"
  ],
  "homepage": "https://github.com/hunzhiwange/ruejs/tree/main/packages/runtime-vapor#readme",
  "bugs": {
    "url": "https://github.com/hunzhiwange/ruejs/issues"
  },
  "license": "MIT",
  "author": "Xiangmin Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunzhiwange/ruejs.git",
    "directory": "packages/runtime-vapor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "development": "./dist/index.node.js",
        "default": "./dist/index.node.js"
      },
      "development": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compiled": {
      "types": "./dist/compiled.d.ts",
      "import": "./dist/compiled.js",
      "default": "./dist/compiled.js"
    },
    "./reactive": {
      "types": "./dist/reactive.d.ts",
      "node": {
        "development": "./dist/reactive.node.js",
        "default": "./dist/reactive.node.js"
      },
      "development": "./dist/reactive.js",
      "import": "./dist/reactive.js",
      "default": "./dist/reactive.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./vapor": {
      "types": "./dist/vapor.d.ts",
      "node": {
        "development": "./dist/vapor.node.js",
        "default": "./dist/vapor.node.js"
      },
      "development": "./dist/vapor.js",
      "import": "./dist/vapor.js",
      "default": "./dist/vapor.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build-ts": "node ./scripts/emit-typescript-runtime.mjs",
    "build-ts:browser": "npm run build-ts -- --platform browser",
    "check-ts": "tsc -p tsconfig.json --noEmit && node ./scripts/emit-typescript-runtime.mjs --check",
    "build": "npm run build-ts",
    "build-vapor": "npm run build-ts -- --platform browser",
    "build-node": "npm run build-ts -- --platform node",
    "prepublishOnly": "npm run check-ts && npm run build",
    "prepack": "npm run check-ts && npm run build",
    "dev": "tsc -p tsconfig.json --noEmit --watch",
    "test": "pnpm -w exec vitest run scripts/__tests__/runtime-vapor-typescript.spec.ts scripts/__tests__/runtime-vapor-no-wasm.spec.ts --project unit",
    "check": "npm run check-ts",
    "test-coverage": "pnpm -w exec vitest run scripts/__tests__/runtime-vapor-typescript.spec.ts scripts/__tests__/runtime-vapor-no-wasm.spec.ts --project unit --coverage",
    "test-coverage-js": "npm run test-coverage"
  },
  "devDependencies": {
    "c8": "^11.0.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
