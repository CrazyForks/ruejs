{
  "name": "@rue-js/runtime-vapor",
  "version": "0.8.7",
  "description": "Rue runtime implemented in Rust and compiled to WebAssembly",
  "keywords": [
    "rue",
    "runtime",
    "wasm"
  ],
  "homepage": "https://github.com/hunzhiwange/ruejs/tree/main/packages/runtime-vapor#readme",
  "bugs": {
    "url": "https://github.com/hunzhiwange/ruejs/issues"
  },
  "license": "MIT",
  "author": "Xiangmin Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunzhiwange/ruejs.git",
    "directory": "packages/runtime-vapor"
  },
  "files": [
    "index.js",
    "index.node.js",
    "index.d.ts",
    "pkg",
    "pkg-node",
    "reactive.js",
    "reactive.node.js",
    "reactive.d.ts",
    "runtime-entry-wrap.js",
    "vapor.js",
    "vapor.node.js",
    "vapor-bridge.js",
    "vapor.d.ts"
  ],
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": {
        "development": "./index.node.js",
        "default": "./index.node.js"
      },
      "development": "./index.js",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./reactive": {
      "types": "./reactive.d.ts",
      "node": {
        "development": "./reactive.node.js",
        "default": "./reactive.node.js"
      },
      "development": "./reactive.js",
      "import": "./reactive.js",
      "default": "./reactive.js"
    },
    "./vapor": {
      "types": "./vapor.d.ts",
      "node": {
        "development": "./vapor.node.js",
        "default": "./vapor.node.js"
      },
      "development": "./vapor.js",
      "import": "./vapor.js",
      "default": "./vapor.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cleanup-wasm-pack": "node -e \"const fs=require('fs');for(const p of ['pkg/.gitignore','pkg-node/.gitignore']){if(fs.existsSync(p))fs.unlinkSync(p)}\"",
    "build-profiling": "node ./scripts/run-wasm-pack.mjs build --profiling --target bundler --out-dir pkg --features dev --features log && npm run cleanup-wasm-pack",
    "build-dev": "node ./scripts/run-wasm-pack.mjs build --release --target bundler --out-dir pkg --features dev --features log && npm run cleanup-wasm-pack",
    "build": "node ./scripts/run-wasm-pack.mjs build --release --target bundler --out-dir pkg && npm run cleanup-wasm-pack",
    "build-node": "node ./scripts/run-wasm-pack.mjs build --release --target nodejs --out-dir pkg-node --features log --features dev && npm run cleanup-wasm-pack",
    "prepublishOnly": "npm run build && npm run build-node",
    "prepack": "npm run build && npm run build-node",
    "dev": "node ./scripts/run-wasm-pack.mjs watch",
    "docs": "cargo doc --no-deps",
    "test": "node ./scripts/run-wasm-pack.mjs test --node",
    "check": "cargo check",
    "fmt": "cargo fmt",
    "test-coverage": "cargo llvm-cov  --html --open",
    "test-coverage-wasm": "node ./scripts/run-wasm-coverage.mjs",
    "test-coverage-wasm-html": "node ./scripts/run-wasm-coverage.mjs --html",
    "test-coverage-wasm-lcov": "node ./scripts/run-wasm-coverage.mjs --lcov",
    "test-coverage-wasm-all": "node ./scripts/run-wasm-coverage.mjs --html --lcov",
    "test-coverage-js": "c8 --reporter=lcov --reporter=text node ./scripts/run-wasm-pack.mjs test --node"
  },
  "devDependencies": {
    "c8": "^11.0.0"
  }
}
