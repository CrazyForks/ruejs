{
  "name": "@rue-js/design",
  "version": "0.8.10",
  "description": "@rue-js/design",
  "keywords": [
    "rue"
  ],
  "homepage": "https://github.com/hunzhiwange/ruejs/tree/main/packages/rue-design#readme",
  "bugs": {
    "url": "https://github.com/hunzhiwange/ruejs/issues"
  },
  "license": "MIT",
  "author": "Xiangmin Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunzhiwange/ruejs.git",
    "directory": "src/packages/design"
  },
  "files": [
    "index.js",
    "dist/*.js",
    "dist/*.d.ts",
    "dist/components",
    "dist/__types/src/index.d.ts",
    "dist/__types/src/components/*/index.d.ts",
    "dist/__types/src/components/qr-code/encoder.d.ts"
  ],
  "sideEffects": false,
  "main": "index.js",
  "module": "dist/rue-design.esm-bundler.js",
  "types": "dist/rue-design.d.ts",
  "unpkg": "dist/rue-design.global.js",
  "exports": {
    ".": {
      "types": "./dist/rue-design.d.ts",
      "development": "./dist/rue-design.esm-bundler.js",
      "node": {
        "production": "./dist/rue-design.cjs.prod.js",
        "development": "./dist/rue-design.cjs.js",
        "default": "./index.js"
      },
      "module": "./dist/rue-design.esm-bundler.js",
      "import": "./dist/rue-design.esm-bundler.js",
      "require": "./index.js"
    },
    "./*": {
      "types": "./dist/__types/src/components/*/index.d.ts",
      "development": "./dist/components/esm/*.js",
      "import": "./dist/components/esm/*.js",
      "module": "./dist/components/esm/*.js",
      "require": "./dist/components/cjs/*.js"
    }
  },
  "dependencies": {
    "@rue-js/router": "workspace:*",
    "@rue-js/rue": "workspace:*",
    "@rue-js/shared": "workspace:*",
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@types/trusted-types": "^2.0.7"
  },
  "buildOptions": {
    "name": "RueRuntimeDOM",
    "formats": [
      "esm-bundler",
      "esm-browser",
      "cjs",
      "global"
    ],
    "subpathEntries": {
      "source": "src/components",
      "formats": [
        "esm-bundler",
        "cjs"
      ]
    }
  }
}
