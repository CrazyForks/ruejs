{
  "name": "@rue-js/runtime",
  "version": "0.8.20",
  "description": "@rue-js/runtime",
  "keywords": [
    "rue"
  ],
  "homepage": "https://github.com/hunzhiwange/ruejs/tree/main/packages/runtime#readme",
  "bugs": {
    "url": "https://github.com/hunzhiwange/ruejs/issues"
  },
  "license": "MIT",
  "author": "Xiangmin Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunzhiwange/ruejs.git",
    "directory": "src/packages/runtime"
  },
  "files": [
    "index.js",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "module": "dist/runtime.esm-bundler.js",
  "types": "dist/runtime.d.ts",
  "unpkg": "dist/runtime.global.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "module": "./dist/runtime.esm-bundler.js",
      "import": "./dist/runtime.esm-bundler.js",
      "development": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "module": "./dist/runtime.server.esm-bundler.js",
      "import": "./dist/runtime.server.esm-bundler.js",
      "development": "./src/server.ts"
    },
    "./vapor": {
      "types": "./src/vapor.ts",
      "module": "./dist/runtime.vapor.esm-bundler.js",
      "import": "./dist/runtime.vapor.esm-bundler.js",
      "development": "./src/vapor.ts"
    },
    "./compiled": {
      "types": "./src/compiled.ts",
      "module": "./dist/runtime.compiled.esm-bundler.js",
      "import": "./dist/runtime.compiled.esm-bundler.js",
      "development": "./src/compiled.ts"
    },
    "./vapor-core": {
      "types": "./src/vapor-core.ts",
      "module": "./dist/runtime.vapor-core.esm-bundler.js",
      "import": "./dist/runtime.vapor-core.esm-bundler.js",
      "development": "./src/vapor-core.ts"
    },
    "./island": {
      "types": "./src/island.ts",
      "module": "./dist/runtime.island.esm-bundler.js",
      "import": "./dist/runtime.island.esm-bundler.js",
      "development": "./src/island.ts"
    },
    "./server-island": {
      "types": "./src/server-island.ts",
      "module": "./dist/runtime.server-island.esm-bundler.js",
      "import": "./dist/runtime.server-island.esm-bundler.js",
      "development": "./src/server-island.ts"
    },
    "./dom": {
      "types": "./src/dom.ts",
      "module": "./dist/runtime.dom.esm-bundler.js",
      "import": "./dist/runtime.dom.esm-bundler.js",
      "development": "./src/dom.ts"
    },
    "./*": "./*"
  },
  "dependencies": {
    "@rue-js/runtime-vapor": "workspace:*",
    "@rue-js/shared": "workspace:*",
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@types/trusted-types": "^2.0.7"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "buildOptions": {
    "name": "RueRuntimeDOM",
    "formats": [
      "esm-bundler",
      "esm-browser",
      "global"
    ],
    "subEntries": [
      {
        "entry": "src/server.ts",
        "filename": "runtime.server",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/vapor.ts",
        "filename": "runtime.vapor",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/compiled.ts",
        "filename": "runtime.compiled",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/vapor-core.ts",
        "filename": "runtime.vapor-core",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/island.ts",
        "filename": "runtime.island",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/server-island.ts",
        "filename": "runtime.server-island",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/dom.ts",
        "filename": "runtime.dom",
        "formats": [
          "esm-bundler"
        ]
      }
    ]
  }
}
