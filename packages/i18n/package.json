{
  "name": "@rue-js/i18n",
  "version": "0.8.20",
  "description": "@rue-js/i18n",
  "keywords": [
    "i18n",
    "internationalization",
    "rue"
  ],
  "homepage": "https://github.com/hunzhiwange/ruejs/tree/main/packages/i18n#readme",
  "bugs": {
    "url": "https://github.com/hunzhiwange/ruejs/issues"
  },
  "license": "MIT",
  "author": "Xiangmin Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunzhiwange/ruejs.git",
    "directory": "packages/i18n"
  },
  "files": [
    "index.js",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "module": "dist/i18n.esm-bundler.js",
  "types": "dist/i18n.d.ts",
  "exports": {
    ".": {
      "types": "./dist/i18n.d.ts",
      "development": "./src/index.ts",
      "module": "./dist/i18n.esm-bundler.js",
      "import": "./dist/i18n.esm-bundler.js"
    },
    "./*": "./*"
  },
  "dependencies": {
    "@rue-js/rue": "workspace:*"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "buildOptions": {
    "name": "RueI18n",
    "formats": [
      "esm-bundler"
    ]
  }
}
