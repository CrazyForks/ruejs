{
  "name": "@rue-js/rue",
  "version": "0.8.21",
  "description": "后悔药 Rue.js - The Wasm Framework For Native DOM.",
  "keywords": [
    "rue"
  ],
  "homepage": "https://github.com/hunzhiwange/ruejs/tree/main/packages/rue#readme",
  "bugs": {
    "url": "https://github.com/hunzhiwange/ruejs/issues"
  },
  "license": "MIT",
  "author": "Xiangmin Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunzhiwange/ruejs.git"
  },
  "files": [
    "index.js",
    "dist",
    "src",
    "jsx.d.ts"
  ],
  "type": "module",
  "main": "index.js",
  "module": "dist/rue.runtime.esm-bundler.js",
  "types": "dist/rue.d.ts",
  "unpkg": "dist/rue.global.js",
  "jsdelivr": "dist/rue.global.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "module": "./dist/rue.runtime.esm-bundler.js",
      "import": "./dist/rue.runtime.esm-bundler.js"
    },
    "./vapor": {
      "types": "./src/vapor.ts",
      "development": "./src/vapor.ts",
      "module": "./dist/rue.vapor.esm-bundler.js",
      "import": "./dist/rue.vapor.esm-bundler.js"
    },
    "./compiled": {
      "types": "./src/compiled.ts",
      "development": "./src/compiled.ts",
      "module": "./dist/rue.compiled.esm-bundler.js",
      "import": "./dist/rue.compiled.esm-bundler.js"
    },
    "./server-renderer": {
      "types": "./src/server-renderer.ts",
      "development": "./src/server-renderer.ts",
      "module": "./dist/rue.server-renderer.esm-bundler.js",
      "import": "./dist/rue.server-renderer.esm-bundler.js"
    },
    "./island": {
      "types": "./src/island.ts",
      "development": "./src/island.ts",
      "module": "./dist/rue.island.esm-bundler.js",
      "import": "./dist/rue.island.esm-bundler.js"
    },
    "./jsx": "./jsx.d.ts",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rue-js/runtime": "workspace:*",
    "@rue-js/server-renderer": "workspace:*",
    "@rue-js/shared": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "buildOptions": {
    "name": "rue",
    "formats": [
      "esm-bundler",
      "esm-bundler-runtime",
      "global",
      "global-runtime",
      "esm-browser",
      "esm-browser-runtime"
    ],
    "subEntries": [
      {
        "entry": "src/server-renderer.ts",
        "filename": "rue.server-renderer",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/vapor.ts",
        "filename": "rue.vapor",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/compiled.ts",
        "filename": "rue.compiled",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/island.ts",
        "filename": "rue.island",
        "formats": [
          "esm-bundler"
        ]
      }
    ]
  }
}
