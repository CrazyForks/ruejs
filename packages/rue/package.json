{
  "name": "@rue-js/rue",
  "version": "0.9.1",
  "description": "后悔药 Rue.js - The Compiler Framework For Native DOM.",
  "keywords": [
    "rue"
  ],
  "homepage": "https://github.com/hunzhiwange/ruejs/tree/main/packages/rue#readme",
  "bugs": {
    "url": "https://github.com/hunzhiwange/ruejs/issues"
  },
  "license": "MIT",
  "author": "Xiangmin Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunzhiwange/ruejs.git"
  },
  "files": [
    "index.js",
    "dist",
    "src",
    "jsx.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "index.js",
  "module": "dist/rue.runtime.esm-bundler.js",
  "types": "dist/rue.d.ts",
  "unpkg": "dist/rue.global.js",
  "jsdelivr": "dist/rue.global.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "module": "./dist/rue.runtime.esm-bundler.js",
      "import": "./dist/rue.runtime.esm-bundler.js"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "development": "./src/internal.ts",
      "module": "./dist/rue.internal.esm-bundler.js",
      "import": "./dist/rue.internal.esm-bundler.js"
    },
    "./internal/compiler": {
      "types": "./src/compiler-internal.ts",
      "development": "./src/compiler-internal.ts",
      "module": "./dist/rue.internal-compiler.esm-bundler.js",
      "import": "./dist/rue.internal-compiler.esm-bundler.js"
    },
    "./server-renderer": {
      "types": "./src/server-renderer.ts",
      "development": "./src/server-renderer.ts",
      "module": "./dist/rue.server-renderer.esm-bundler.js",
      "import": "./dist/rue.server-renderer.esm-bundler.js"
    },
    "./island": {
      "types": "./src/island.ts",
      "development": "./src/island.ts",
      "module": "./dist/rue.island.esm-bundler.js",
      "import": "./dist/rue.island.esm-bundler.js"
    },
    "./jsx": "./jsx.d.ts",
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.ts",
      "development": "./src/jsx-runtime.ts",
      "import": "./src/jsx-runtime.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-dev-runtime.ts",
      "development": "./src/jsx-dev-runtime.ts",
      "import": "./src/jsx-dev-runtime.ts"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@rue-js/runtime": "workspace:*",
    "@rue-js/server-renderer": "workspace:*",
    "@rue-js/shared": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "buildOptions": {
    "name": "rue",
    "formats": [
      "esm-bundler",
      "esm-bundler-runtime",
      "global",
      "global-runtime",
      "esm-browser",
      "esm-browser-runtime"
    ],
    "subEntries": [
      {
        "entry": "src/server-renderer.ts",
        "filename": "rue.server-renderer",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/internal.ts",
        "filename": "rue.internal",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/compiler-internal.ts",
        "filename": "rue.internal-compiler",
        "formats": [
          "esm-bundler"
        ]
      },
      {
        "entry": "src/island.ts",
        "filename": "rue.island",
        "formats": [
          "esm-bundler"
        ]
      }
    ]
  }
}
